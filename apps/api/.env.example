# Core
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Supabase: use the pooler for DATABASE_URL (Project Settings → Database →
# Connection string → Transaction pooler, port 6543) and the session pooler
# or direct connection (port 5432) for DATABASE_DIRECT_URL — live updates
# (LISTEN/NOTIFY) and migrations need a session connection. TLS is enabled
# automatically for *.supabase.co / *.supabase.com hosts; paste the project's
# SSL certificate into DATABASE_CA_CERT to also verify the server.
# Keep the database in the same region as the app (e.g. Railway us-east ↔
# Supabase us-east-1) — every query pays that round trip.
DATABASE_URL=postgres://vahlay:vahlay@localhost:5432/vahlay

DATABASE_DIRECT_URL=
DATABASE_CA_CERT=
DATABASE_POOL_MAX=15

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Credential encryption (32-byte key, base64). Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Background jobs (leave unset to disable queues/workers)
REDIS_URL=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible (works with Supabase Storage's S3 endpoint, AWS S3, MinIO)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# AI
OPENAI_API_KEY=

# Telephony
# Plivo carries India calling (VahlayHR AI interviews). Twilio carries US
# calling (Vahlay Voice AI campaigns) and Coverage's carrier verification.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Voice AI (US campaigns run on VAPI with your Twilio numbers + Cartesia voices).
# VAPI_API_KEY is your VAPI *private* key (or set it per org in Settings).
# API_URL above must be publicly reachable over HTTPS in production — VAPI
# posts call events to ${API_URL}/api/webhooks/vapi.
# VAPI_WEBHOOK_SECRET is optional; if unset one is derived from
# CREDENTIALS_ENCRYPTION_KEY. Changing it requires re-syncing numbers.
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
CARTESIA_API_KEY=

# Lead sources
GOOGLE_PLACES_API_KEY=

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=

# Lead Discovery — OpenStreetMap (free, no API key). Defaults work as-is.
# OSM_CONTACT_EMAIL=you@yourcompany.com   # sent to Nominatim per its usage policy
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter
