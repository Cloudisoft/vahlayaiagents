# Core
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgres://vahlay:vahlay@localhost:5432/vahlay

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Credential encryption (32-byte key, base64). Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Background jobs (leave unset to disable queues/workers)
REDIS_URL=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible (works with Supabase Storage's S3 endpoint, AWS S3, MinIO)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# AI
OPENAI_API_KEY=

# Telephony
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Voice
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
CARTESIA_API_KEY=

# Lead sources
GOOGLE_PLACES_API_KEY=

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
